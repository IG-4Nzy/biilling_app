# ─── Application ───
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://billing_user:billing_pass@localhost:5432/billing_db?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ───
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (AES-256) ───
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-in-production!!

# ─── MFA ───
MFA_APP_NAME=EnterpriseBilling

# ─── Storage ───
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ─── Email (optional) ───
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@yourdomain.com

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
